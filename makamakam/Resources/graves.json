  "memories": [
    {
      "id": "m1",
      "graveID": "A-2-03",
      "authorName": "Pak Gede Suarna",
      "relationship": "Tetangga lama di Gang Merpati",
      "body": "Tiap Jumat sore Bu Sari menyapu depan rumahnya sampai ke depan rumah saya, dan kalau saya protes dia bilang sapunya tidak tahu batas pagar. Sepuluh tahun begitu. Halaman saya belum pernah sebersih itu lagi.",
      "writtenAt": "2024-06-12T09:20:00Z"
    },
    {
      "id": "m2",
      "graveID": "A-2-03",
      "authorName": "Hendra Wijaya",
      "relationship": "Teman sekolah, SMP 1 Kuta",
      "body": "Tahun 1985 dia yang mengajari saya naik motor di lapangan belakang sekolah, dan dia berteriak sepanjang jalan. Saya tidak pernah bilang ke keluarganya bahwa saya bisa naik motor karena anaknya.",
      "writtenAt": "2024-09-03T14:05:00Z"
    },
    {
      "id": "m3",
      "graveID": "A-3-02",
      "authorName": "Ibu Ratna",
      "relationship": "Rekan kerja di pasar Tuban",
      "body": "Bu Nur selalu menyisihkan dagangan yang paling bagus untuk pembeli yang datang paling akhir, katanya yang datang terakhir biasanya yang paling tidak punya pilihan.",
      "writtenAt": "2024-04-28T02:40:00Z"
    }
  ],
